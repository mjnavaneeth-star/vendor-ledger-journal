rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Vendor Ledger Journal: strict user isolation
    // Scopes all reads/writes to request.auth.uid == resource.data.userId
    // (or request.resource.data.userId on create) — zero cross-user leakage.
    match /ledgerEntries/{entryId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // User Profile (jurisdiction, trading duration, operational settings)
    // Strictly scoped: request.auth.uid == userId
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Zero Insecure Defaults: Explicit denial of all unmatched collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

